# Copy to .env (gitignored). On AWS these come from SSM Parameter Store (feedwatch-platform docs/DEPLOYMENT.md).
RUST_LOG=info
FEEDWATCH_API_ADDR=127.0.0.1:8080
INFLUX_URL=http://127.0.0.1:8086
INFLUX_ORG=feedwatch
INFLUX_BUCKET=feedwatch
INFLUX_TOKEN=change-me
# The site origin allowed by CORS (GR-2).
FEEDWATCH_ALLOWED_ORIGIN=http://localhost:3000
